# Included only by ORT's top-level project; no upstream source patch.
set(ZENSALLY_PROBE_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(zensally_add_native_probes)
  add_executable(ort-native-single "${ZENSALLY_PROBE_SOURCE_DIR}/probe.cpp")
  target_include_directories(ort-native-single PRIVATE "${REPO_ROOT}/include/onnxruntime/core/session" "${ZENSALLY_EMBED_DIR}")
  target_compile_features(ort-native-single PRIVATE cxx_std_17)
  target_link_libraries(ort-native-single PRIVATE onnxruntime)
  if(APPLE)
    target_link_options(ort-native-single PRIVATE "LINKER:-dead_strip")
  elseif(UNIX)
    target_link_options(ort-native-single PRIVATE "LINKER:--gc-sections")
  endif()
  if(ZENSALLY_STOCK_LIBRARY)
    add_executable(ort-native-stock "${ZENSALLY_PROBE_SOURCE_DIR}/probe.cpp")
    target_include_directories(ort-native-stock PRIVATE "${REPO_ROOT}/include/onnxruntime/core/session" "${ZENSALLY_EMBED_DIR}")
    target_compile_features(ort-native-stock PRIVATE cxx_std_17)
    target_link_libraries(ort-native-stock PRIVATE "${ZENSALLY_STOCK_LIBRARY}")
  endif()
endfunction()
cmake_language(DEFER CALL zensally_add_native_probes)
